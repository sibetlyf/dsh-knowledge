# 复制为 /etc/team-kb.env，权限 600。
# 首次启动可设置以下两项创建管理员；创建成功后删除密码并重启。
# TEAM_ADMIN_EMAIL=admin@example.com
# TEAM_ADMIN_PASSWORD=replace-with-a-long-password
# TEAM_ADMIN_NAME=管理员

TEAM_DATA_DIR=/opt/team-kb/data
TEAM_HOST=127.0.0.1
TEAM_PORT=8787
TEAM_TITLE=团队知识库
TEAM_PUBLIC_ORIGIN=https://kb.example.com
TEAM_TRUST_PROXY=1
TEAM_SESSION_DAYS=7
TEAM_MAX_BODY_BYTES=5242880
TEAM_MAX_FILE_BYTES=104857600

# 可选：OpenAI 兼容模型；不配置时问答和 Wiki 使用抽取式证据。
# TEAM_LLM_API_BASE=https://api.example.com/v1
# TEAM_LLM_API_KEY=
# TEAM_LLM_MODEL=

# 自动 Wiki / 团队日报汇总。默认开启；设为 0 可关闭。
# 团队日报汇总
TEAM_AUTO_WIKI=1
TEAM_AUTO_WORKLOG=1
# 日报统一写入的团队知识库 ID；省略时由客户端指定
TEAM_WORKLOG_BASE=default
# 每天几点后生成当日团队日报汇总（0-23）
TEAM_WORKLOG_SUMMARY_HOUR=19
# 后台自动任务执行间隔（分钟）
TEAM_AUTO_INTERVAL_MINUTES=30
